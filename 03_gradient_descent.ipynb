   "source": [
    "import numpy as np\n",
    "\n",
    "x = 2\n",
    "target = 10\n",
    "w = 3\n",
    "lr = 0.3\n",
    "\n",
    "for step in range(20):\n",
    "    guess = x * w\n",
    "    error = (guess - target)**2\n",
    "    derivative = 2 * x * (guess - target)\n",
    "    w = w - (lr * derivative)\n",
    "    print(step, w, error)\n"
   ]
  }
